#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/foostan/corne/5column.dtsi>
#include <layouts/foostan/corne/6column.dtsi>

&foostan_corne_6col_layout {
    transform = <&default_transform>;
};

&foostan_corne_5col_layout {
    transform = <&five_column_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
            RC(0,2) RC(1,2) RC(2,2) RC(3,2) RC(4,2) RC(5,2)  RC(5,8) RC(4,8) RC(3,8) RC(2,8) RC(1,8) RC(0,8)
            RC(0,3) RC(1,3) RC(2,3) RC(3,3) RC(4,3) RC(5,3)  RC(5,9) RC(4,9) RC(3,9) RC(2,9) RC(1,9) RC(0,9)
            RC(0,4) RC(1,4) RC(2,4) RC(3,4) RC(4,4) RC(5,4)  RC(5,10) RC(4,10) RC(3,10) RC(2,10) RC(1,10) RC(0,10)
                                    RC(0,5) RC(1,5) RC(2,5)  RC(2,11) RC(1,11) RC(0,11)
        >;
    };

    five_column_transform: keymap_transform_1 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
                    RC(1,2) RC(2,2) RC(3,2) RC(4,2) RC(5,2)  RC(5,8) RC(4,8) RC(3,8) RC(2,8) RC(1,8)
                    RC(1,3) RC(2,3) RC(3,3) RC(4,3) RC(5,3)  RC(5,9) RC(4,9) RC(3,9) RC(2,9) RC(1,9)
                    RC(1,4) RC(2,4) RC(3,4) RC(4,4) RC(5,4)  RC(5,10) RC(4,10) RC(3,10) RC(2,10) RC(1,10)
                            RC(0,5) RC(1,5) RC(2,5)  RC(2,11) RC(1,11) RC(0,11)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        row-gpios = <
            &gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
            &gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
            &gpio1 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
            &gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)
        >;
    };
};
