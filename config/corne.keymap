#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp Q &kp W &kp E &kp R &kp T &kp Y   &none &none &none &none &none &none
        &kp A &kp S &kp D &kp F &kp G &kp H   &none &none &none &none &none &none
        &kp Z &kp X &kp C &kp V &kp B &kp N   &none &none &none &none &none &none
        &kp X &kp Y &kp Z &none &none &none   &none &none &none &none &none &none

      >;
    };
  };
};